# GO
export GOROOT=/workspace/local/go
export GOPATH=/workspace/gopath
export GOPROJ=/workspace/gopath/src/arti
export PATH=$GOROOT/bin:$GOPATH/bin:$PATH
# Data
export FCBH_DATASET_DB=/workspace/data
export FCBH_DATASET_FILES=/workspace/data/download
export FCBH_DATASET_TMP=/workspace/data/tmp
# Conda ENVS
export FCBH_AENEAS_PYTHON=/workspace/miniforge3/envs/aeneas/bin/python
export FCBH_FASTTEXT_EXE=/workspace/miniforge3/envs/fasttext/fastText/fasttext # not implemented
export FCBH_LIBROSA_PYTHON=/workspace/miniforge3/envs/librosa/bin/python
export FCBH_MMS_ASR_PYTHON=/workspace/miniforge3/envs/mms_asr/bin/python
export FCBH_MMS_FA_PYTHON=/workspace/miniforge3/envs/mms_fa/bin/python
export FCBH_MMS_ADAPTER_PYTHON=/workspace/miniforge3/envs/mms_adapter/bin/python
export FCBH_UROMAN_EXE=/workspace/miniforge3/envs/mms_fa/bin/uroman.pl
export FCBH_WHISPER_EXE=/workspace/miniforge3/envs/whisper/bin/whisper
# Logging
export FCBH_DATASET_LOG_FILE=/workspace/arti.log
export FCBH_DATASET_LOG_LEVEL=DEBUG
# Cuda
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# SMTP
export SMTP_SENDER_EMAIL=?
export SMTP_PASSWORD=?
export SMTP_HOST_NAME=?
export SMTP_HOST_PORT=587
# S3 Datastore
S3_ENDPOINT_URL=https://s3api-US-CA-2.runpod.io # leave blank for AWS
S3_REGION=US-CA-2
#S3_BUCKET=your_network_volume_id
# S3 Buckets
export FCBH_DATASET_QUEUE=arti-queue
export FCBH_DATASET_IN_BUCKET=arti-input
export FCBH_DATASET_IO_BUCKET=arti-output
